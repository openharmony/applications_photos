export enum FileType {
  PDF = 'pdf',
  EXE = 'exe',
  TEXT = 'text',
  MUSIC = 'music',
  COMPRESSED = 'compressed',
  PICTURE = 'picture',
  VIDEO = 'video',
  XLS = 'xls',
  DOC = 'doc',
  PPT = 'ppt',
  UNKNOWN = 'unknown',
}

export function checkIsSpecialType(uri: string, type: FileType): boolean {
  let extension: string | undefined = uri.split('.').pop();
  if (!extension) {
    return false;
  }
  if (extension.indexOf('?') !== -1) {
    extension = extension.substring(0, extension.indexOf('?'));
  }
  return FileDisplayType[extension.toUpperCase()] === type;
}
