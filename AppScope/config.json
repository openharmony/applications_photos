{
  "app": {
    "bundleName": "com.ohos.photos",
    "vendor": "ohos",
    "version": {
      "code": 60000666,
      "name": "6.0.0.666"
    }
  },
  "deviceConfig": {},
  "module": {
    "package": "com.ohos.photos",
    "name": ".pc",
    "mainAbility": ".MainAbility",
    "deviceType": [
      "phone"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "pc",
      "moduleType": "entry",
      "installationFree": false
    },
    "abilities": [
      {
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ],
        "orientation": "unspecified",
        "visible": true,
        "srcPath": "MainAbility",
        "name": ".MainAbility",
        "srcLanguage": "ets",
        "icon": "$media:ohos_gallery",
        "description": "$string:description_mainability",
        "formsEnabled": false,
        "label": "$string:app_name",
        "type": "page",
        "launchType": "singleton"
      }
    ],
    "js": [
      {
        "mode": {
          "syntax": "ets",
          "type": "pageAbility"
        },
        "pages": [
          "MainAbility/view/index",
          "MainAbility/view/PhotoGridPage",
          "MainAbility/view/PhotoBrowser",
          "FormAbility/view/PhotoBrowserSnapshot",
          "pickerability/view/ThirdSelectPhotoGridPage",
          "pickerability/view/PickerSheetPage",
          "pages/GrantOldPhotoAssetsPage",
          "MainAbility/view/MediaOperationPage",
          "MainAbility/view/DefaultPhotoPage",
          "FormAbility/view/FormEditorPage",
          "pages/PhotoInfoEditPage"
        ],
        "name": ".MainAbility",
        "window": {
          "designWidth": 720,
          "autoDesignWidth": false
        }
      }
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "$string:media_and_documents_description"
      },
      {
        "name": "ohos.permission.READ_IMAGEVIDEO",
        "reason": "$string:media_and_documents_description"
      },
      {
        "name": "ohos.permission.WRITE_IMAGEVIDEO",
        "reason": "$string:media_and_documents_description"
      },
      {
        "name": "ohos.permission.GET_BUNDLE_INFO",
        "reason": "$string:determine_the_logic_for_starting_the_service_from_third_party_app"
      },
      {
        "name": "ohos.permission.MANAGE_PRIVATE_PHOTOS",
        "reason": "$string:ability_for_hide_album"
      },
      {
        "name": "ohos.permission.STORAGE_MANAGER",
        "reason": "$string:ability_for_hide_album"
      }
    ]
  }
}
