{
  "module": {
    "name": "photos_formAbility",
    "type": "har",
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "metadata": [
      {
        "name": "license_file_path",
        "value": "/system/etc/noticeFile/PhotosHm_OpenSource.html"
      }
    ],
    "requestPermissions": [{
      "name": "ohos.permission.READ_IMAGEVIDEO",
      "reason": "$string:read_imagevideo_desc",
      "usedScene": {
        "abilities": [
          "MainAbility",
          "FormAbility",
          "photos_formAbility"
        ]
      }
    }],
    "uiSyntax": "ets"
  }
}
